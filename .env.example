# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# ⚠️ NEVER commit .env to git - it contains sensitive credentials

# ============================================================================
# REQUIRED CONFIGURATION - Must be set before running
# ============================================================================

# Google Gemini API Key (required for AI coordination)
# Get from: https://ai.google.dev/
# Free tier includes 60 requests/minute
GEMINI_API_KEY=your-gemini-api-key-here

# Kaggle API Credentials (required for competitions)
# Get from: https://www.kaggle.com/settings/account → API → Create New Token
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

# ============================================================================
# OPTIONAL CONFIGURATION - Sensible defaults provided
# ============================================================================

# --- LLM Provider Settings ---
# Which AI provider to use for decision-making
LLM_PROVIDER=google                    # Options: google, openai, anthropic
LLM_MODEL=gemini-2.0-flash-exp         # Specific model to use

# Alternative providers (if using different than google)
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key

# --- System Configuration ---
LOG_LEVEL=INFO                         # Logging level: DEBUG, INFO, WARNING, ERROR
ENABLE_GPU=true                        # Use GPU if available (faster training)
DEBUG_MODE=false                       # Extra debug logging and diagnostics

# --- Default Parameters ---
DEFAULT_TARGET_PERCENTILE=0.20         # Default target percentile (0.0-1.0)
DEFAULT_MAX_ACTIONS=50                 # Default max actions per run
DEFAULT_MAX_ITERATIONS=10              # Default max iterations

# --- Data Processing ---
DATA_SAMPLE_SIZE=None                  # Sample size for data (None = use all)
RANDOM_SEED=42                         # For reproducibility
TRAIN_TEST_SPLIT=0.2                   # Validation split ratio

# --- Model Training ---
CROSS_VALIDATION_FOLDS=5               # K-fold cross-validation
BATCH_SIZE=32                          # Batch size for model training
EPOCHS=100                             # Max epochs for neural networks
EARLY_STOPPING_PATIENCE=10             # Patience for early stopping

# --- Feature Engineering ---
MAX_FEATURES=100                       # Maximum features to create
MIN_FEATURE_IMPORTANCE=0.001           # Minimum importance threshold
FEATURE_SELECTION_METHOD=mutual_info   # Options: mutual_info, correlation, lasso

# --- Model Selection ---
ENABLE_LIGHTGBM=true                   # Include LightGBM
ENABLE_XGBOOST=true                    # Include XGBoost
ENABLE_RANDOM_FOREST=false             # Include Random Forest (slower)
ENABLE_LINEAR_MODELS=false             # Include linear models

# --- Hyperparameter Tuning ---
COORDINATOR_TEMPERATURE=0.7            # AI decision randomness (0.0-1.0)
N_HYPERPARAMETER_TRIALS=10             # Number of hyperparameter combinations
HYPERPARAMETER_OPTIMIZATION=true       # Enable hyperparameter tuning

# --- Submission Settings ---
AUTO_SUBMIT=true                       # Automatically submit predictions
SUBMISSION_TIMEOUT=600                 # Timeout in seconds (10 minutes)
MAX_SUBMISSIONS_PER_DAY=None            # Max submissions limit (None = unlimited)

# --- Optimization Loop ---
ITERATIONS_WITHOUT_IMPROVEMENT=3       # Stop after N iterations without improvement
PERCENTILE_IMPROVEMENT_THRESHOLD=0.02  # Min improvement to count as improvement

# --- API Rate Limiting ---
MAX_CONCURRENT_REQUESTS=5              # Max concurrent API requests
REQUEST_TIMEOUT=30                     # Request timeout in seconds
RETRY_ATTEMPTS=3                       # Retry failed requests N times
RETRY_DELAY=2                          # Initial delay between retries (seconds)

# --- Caching ---
ENABLE_CACHE=true                      # Cache intermediate results
CACHE_LOCATION=./cache                 # Where to store cache
CACHE_EXPIRY_HOURS=24                  # Cache expiry time

# --- Logging & Monitoring ---
LOG_FILE=./logs/kaggle_agent.log       # Log file path
LOG_ROTATION=daily                     # Rotate logs: daily, weekly, monthly
ENABLE_METRICS=true                    # Track and log metrics
METRICS_INTERVAL=300                   # Metrics collection interval (seconds)

# --- Database (if tracking runs) ---
ENABLE_DATABASE=false                  # Store results in database
DATABASE_URL=sqlite:///./results.db    # Database connection string
DATABASE_TYPE=sqlite                   # sqlite, postgres, mysql

# --- Advanced Settings ---
VERBOSITY=1                            # Verbosity level (0-3)
SAVE_INTERMEDIATE_MODELS=false         # Save models after each phase
SAVE_PREDICTIONS=true                  # Save predictions to file
SAVE_REPORTS=true                      # Generate HTML reports

# --- Experimental Features ---
ENABLE_ENSEMBLE=true                   # Use ensemble methods
ENABLE_STACKING=false                  # Enable model stacking
ENABLE_BLENDING=true                   # Enable prediction blending
USE_NEURAL_NETWORKS=false              # Include neural network models

# --- Development/Testing ---
TEST_MODE=false                        # Run in test mode (limited data)
DRY_RUN=false                          # Simulate run without API calls
SKIP_DATA_DOWNLOAD=false               # Skip downloading, use cached data

# ============================================================================
# DO NOT EDIT BELOW - System defaults
# ============================================================================
# These are used internally and shouldn't be changed

_SYSTEM_START_TIME=2026-05-08
_PYTHON_VERSION=3.8+
_CONFIG_TEMPLATE_VERSION=1.0
